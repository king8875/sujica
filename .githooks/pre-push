#!/bin/sh
# git push 시 GitHub 푸시 직전에 변경된 테마 파일을 FTP 로 업로드한다.
# 건너뛰려면: SKIP_FTP=1 git push
[ "$SKIP_FTP" = "1" ] && exit 0

ROOT=$(git rev-parse --show-toplevel)
[ -f "$ROOT/.deploy/config.env" ] || { echo "[pre-push] .deploy/config.env 없음 — FTP 배포 건너뜀"; exit 0; }

ZERO=0000000000000000000000000000000000000000
STATUS=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # 브랜치 삭제
  if [ "$remote_sha" = "$ZERO" ]; then
    python3 "$ROOT/.deploy/ftp_deploy.py" --all || STATUS=1
  else
    python3 "$ROOT/.deploy/ftp_deploy.py" --range "$remote_sha" "$local_sha" --delete || STATUS=1
  fi
done

if [ "$STATUS" != "0" ]; then
  echo "[pre-push] FTP 배포 실패 — 푸시를 중단합니다. (무시하려면 SKIP_FTP=1 git push)"
  exit 1
fi
exit 0
